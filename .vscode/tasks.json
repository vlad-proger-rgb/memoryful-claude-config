{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "BE",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoExit",
                "-Command",
                "& .venv/Scripts/Activate.ps1; cls"
            ],
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-NoExit",
                    "-Command",
                    "& .venv/Scripts/Activate.ps1; cls"
                ]
            },
            "osx": {
                "command": "zsh",
                "args": [
                    "-i",
                    "-c",
                    "source .venv/bin/activate; zsh -i"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "-i",
                    "-c",
                    "source .venv/bin/activate; bash -i"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}/memoryful-backend"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
